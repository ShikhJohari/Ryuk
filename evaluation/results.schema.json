{
  "$defs": {
    "AtThreshold": {
      "additionalProperties": false,
      "description": "The rates at a model's frozen threshold: a match iff the top candidate scores at or above\nit. TPIR counts a mated probe whose top candidate is right, misidentification one whose top\ncandidate is wrong; FPIR counts non-mated probes.",
      "properties": {
        "threshold": {
          "$ref": "#/$defs/Cosine"
        },
        "tpir": {
          "$ref": "#/$defs/Rate"
        },
        "fpir": {
          "$ref": "#/$defs/Rate"
        },
        "misidentification": {
          "$ref": "#/$defs/Rate"
        }
      },
      "required": [
        "threshold",
        "tpir",
        "fpir",
        "misidentification"
      ],
      "title": "AtThreshold",
      "type": "object"
    },
    "Bootstrap": {
      "additionalProperties": false,
      "properties": {
        "resamples": {
          "exclusiveMinimum": 0,
          "title": "Resamples",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "confidence": {
          "$ref": "#/$defs/Fraction"
        }
      },
      "required": [
        "resamples",
        "seed",
        "confidence"
      ],
      "title": "Bootstrap",
      "type": "object"
    },
    "Cosine": {
      "maximum": 1.0,
      "minimum": -1.0,
      "type": "number"
    },
    "Crop": {
      "enum": [
        "five-point",
        "box-margin-14",
        "box-margin-32"
      ],
      "type": "string"
    },
    "CropTrial": {
      "additionalProperties": false,
      "description": "A pipeline choice tried on LFW View 1: threshold from DevTrain, accuracy on DevTest.",
      "properties": {
        "network": {
          "$ref": "#/$defs/Network"
        },
        "crop": {
          "$ref": "#/$defs/Crop"
        },
        "threshold": {
          "$ref": "#/$defs/Cosine"
        },
        "accuracy": {
          "$ref": "#/$defs/Fraction"
        },
        "chosen": {
          "title": "Chosen",
          "type": "boolean"
        }
      },
      "required": [
        "network",
        "crop",
        "threshold",
        "accuracy",
        "chosen"
      ],
      "title": "CropTrial",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "description": "A ROC curve as FAR against TAR, from (0, 0) to (1, 1), collinear points dropped.",
      "properties": {
        "far": {
          "items": {
            "$ref": "#/$defs/Fraction"
          },
          "title": "Far",
          "type": "array"
        },
        "tar": {
          "items": {
            "$ref": "#/$defs/Fraction"
          },
          "title": "Tar",
          "type": "array"
        }
      },
      "required": [
        "far",
        "tar"
      ],
      "title": "Curve",
      "type": "object"
    },
    "DetectorId": {
      "additionalProperties": false,
      "properties": {
        "weights_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "min_face_size": {
          "exclusiveMinimum": 0,
          "title": "Min Face Size",
          "type": "integer"
        }
      },
      "required": [
        "weights_sha256",
        "min_face_size"
      ],
      "title": "DetectorId",
      "type": "object"
    },
    "Draw": {
      "enum": [
        "validation",
        "test"
      ],
      "type": "string"
    },
    "DrawResult": {
      "additionalProperties": false,
      "description": "One recognition model on one draw, under the best-photo rule.",
      "properties": {
        "draw": {
          "$ref": "#/$defs/Draw"
        },
        "mated_probes": {
          "exclusiveMinimum": 0,
          "title": "Mated Probes",
          "type": "integer"
        },
        "non_mated_probes": {
          "exclusiveMinimum": 0,
          "title": "Non Mated Probes",
          "type": "integer"
        },
        "rank_1": {
          "$ref": "#/$defs/Rate"
        },
        "at_threshold": {
          "$ref": "#/$defs/AtThreshold"
        },
        "operating_points": {
          "items": {
            "$ref": "#/$defs/OpenSetPoint"
          },
          "title": "Operating Points",
          "type": "array"
        },
        "curve": {
          "$ref": "#/$defs/OpenSetCurve"
        }
      },
      "required": [
        "draw",
        "mated_probes",
        "non_mated_probes",
        "rank_1",
        "at_threshold",
        "operating_points",
        "curve"
      ],
      "title": "DrawResult",
      "type": "object"
    },
    "DrawSelection": {
      "additionalProperties": false,
      "description": "How one CelebA draw was made: its split, seed, counts and the identities in it (#9).",
      "properties": {
        "draw": {
          "$ref": "#/$defs/Draw"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "images": {
          "exclusiveMinimum": 0,
          "title": "Images",
          "type": "integer"
        },
        "usable_images": {
          "minimum": 0,
          "title": "Usable Images",
          "type": "integer"
        },
        "gallery_candidates": {
          "minimum": 0,
          "title": "Gallery Candidates",
          "type": "integer"
        },
        "gallery": {
          "items": {
            "type": "integer"
          },
          "title": "Gallery",
          "type": "array"
        },
        "held_out": {
          "items": {
            "type": "integer"
          },
          "title": "Held Out",
          "type": "array"
        },
        "enrolled_photos": {
          "exclusiveMinimum": 0,
          "title": "Enrolled Photos",
          "type": "integer"
        },
        "mated_probes": {
          "exclusiveMinimum": 0,
          "title": "Mated Probes",
          "type": "integer"
        },
        "non_mated_probes": {
          "exclusiveMinimum": 0,
          "title": "Non Mated Probes",
          "type": "integer"
        },
        "selection_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "draw",
        "split",
        "seed",
        "images",
        "usable_images",
        "gallery_candidates",
        "gallery",
        "held_out",
        "enrolled_photos",
        "mated_probes",
        "non_mated_probes",
        "selection_sha256"
      ],
      "title": "DrawSelection",
      "type": "object"
    },
    "Eligibility": {
      "additionalProperties": false,
      "description": "#9's three tests for the first active model, with the numbers each was judged on.",
      "properties": {
        "model": {
          "$ref": "#/$defs/RecognitionModelId"
        },
        "lfw_gap_points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lfw Gap Points"
        },
        "reproduces_lfw": {
          "title": "Reproduces Lfw",
          "type": "boolean"
        },
        "test_tpir": {
          "$ref": "#/$defs/Rate"
        },
        "test_fpir": {
          "$ref": "#/$defs/Fraction"
        },
        "fpir_within_limit": {
          "title": "Fpir Within Limit",
          "type": "boolean"
        },
        "ms_per_face": {
          "exclusiveMinimum": 0.0,
          "title": "Ms Per Face",
          "type": "number"
        },
        "fast_enough": {
          "title": "Fast Enough",
          "type": "boolean"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "lfw_gap_points",
        "reproduces_lfw",
        "test_tpir",
        "test_fpir",
        "fpir_within_limit",
        "ms_per_face",
        "fast_enough",
        "eligible"
      ],
      "title": "Eligibility",
      "type": "object"
    },
    "FirstActiveModel": {
      "additionalProperties": false,
      "description": "The model the live monitor starts with, and why (#9).",
      "properties": {
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecognitionModelId"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Eligibility"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "model",
        "reason",
        "candidates"
      ],
      "title": "FirstActiveModel",
      "type": "object"
    },
    "Fold": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "$ref": "#/$defs/Fraction"
        },
        "threshold": {
          "$ref": "#/$defs/Cosine"
        },
        "pairs": {
          "exclusiveMinimum": 0,
          "title": "Pairs",
          "type": "integer"
        },
        "excluded": {
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        }
      },
      "required": [
        "accuracy",
        "threshold",
        "pairs",
        "excluded"
      ],
      "title": "Fold",
      "type": "object"
    },
    "Fraction": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "Identification": {
      "additionalProperties": false,
      "description": "Open-set identification on CelebA's validation and test draws (#9, #27).",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "detector": {
          "$ref": "#/$defs/DetectorId"
        },
        "bootstrap": {
          "$ref": "#/$defs/Bootstrap"
        },
        "draws": {
          "items": {
            "$ref": "#/$defs/DrawSelection"
          },
          "title": "Draws",
          "type": "array"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/OpenSetModel"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "provenance",
        "detector",
        "bootstrap",
        "draws",
        "models"
      ],
      "title": "Identification",
      "type": "object"
    },
    "Int8Footnote": {
      "additionalProperties": false,
      "description": "Why Ryuk runs SFace fp32, not int8 (#9): measured on the same View 2 pairs and faces.",
      "properties": {
        "model": {
          "$ref": "#/$defs/RecognitionModelId"
        },
        "accuracy": {
          "$ref": "#/$defs/Fraction"
        },
        "standard_error": {
          "minimum": 0.0,
          "title": "Standard Error",
          "type": "number"
        },
        "cosine_to_fp32_mean": {
          "$ref": "#/$defs/Cosine"
        },
        "cosine_to_fp32_min": {
          "$ref": "#/$defs/Cosine"
        },
        "faces_compared": {
          "exclusiveMinimum": 0,
          "title": "Faces Compared",
          "type": "integer"
        },
        "ms_per_face_int8": {
          "exclusiveMinimum": 0.0,
          "title": "Ms Per Face Int8",
          "type": "number"
        },
        "ms_per_face_fp32": {
          "exclusiveMinimum": 0.0,
          "title": "Ms Per Face Fp32",
          "type": "number"
        }
      },
      "required": [
        "model",
        "accuracy",
        "standard_error",
        "cosine_to_fp32_mean",
        "cosine_to_fp32_min",
        "faces_compared",
        "ms_per_face_int8",
        "ms_per_face_fp32"
      ],
      "title": "Int8Footnote",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "$ref": "#/$defs/Fraction"
        },
        "high": {
          "$ref": "#/$defs/Fraction"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "Interval",
      "type": "object"
    },
    "LfwModel": {
      "additionalProperties": false,
      "description": "One recognition model's LFW View 2 result under the 10-fold recipe (#9).",
      "properties": {
        "model": {
          "$ref": "#/$defs/RecognitionModelId"
        },
        "crop": {
          "$ref": "#/$defs/Crop"
        },
        "accuracy": {
          "$ref": "#/$defs/Fraction"
        },
        "accuracy_if_excluded_were_errors": {
          "$ref": "#/$defs/Fraction"
        },
        "standard_error": {
          "minimum": 0.0,
          "title": "Standard Error",
          "type": "number"
        },
        "folds": {
          "items": {
            "$ref": "#/$defs/Fold"
          },
          "title": "Folds",
          "type": "array"
        },
        "auc": {
          "$ref": "#/$defs/Fraction"
        },
        "operating_points": {
          "items": {
            "$ref": "#/$defs/OperatingPoint"
          },
          "title": "Operating Points",
          "type": "array"
        },
        "roc": {
          "$ref": "#/$defs/Curve"
        },
        "published": {
          "$ref": "#/$defs/Published"
        },
        "gap_points": {
          "title": "Gap Points",
          "type": "number"
        },
        "reproduces_published": {
          "title": "Reproduces Published",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "crop",
        "accuracy",
        "accuracy_if_excluded_were_errors",
        "standard_error",
        "folds",
        "auc",
        "operating_points",
        "roc",
        "published",
        "gap_points",
        "reproduces_published"
      ],
      "title": "LfwModel",
      "type": "object"
    },
    "MatchRule": {
      "const": "best-photo",
      "type": "string"
    },
    "ModelThreshold": {
      "additionalProperties": false,
      "description": "A recognition model's frozen threshold, as the service reads it at startup (#12).",
      "properties": {
        "model": {
          "$ref": "#/$defs/RecognitionModelId"
        },
        "rule": {
          "$ref": "#/$defs/MatchRule"
        },
        "threshold": {
          "$ref": "#/$defs/Cosine"
        },
        "target_fpir": {
          "$ref": "#/$defs/Fraction"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        }
      },
      "required": [
        "model",
        "rule",
        "threshold",
        "target_fpir",
        "commit",
        "date"
      ],
      "title": "ModelThreshold",
      "type": "object"
    },
    "Network": {
      "enum": [
        "arcface",
        "facenet",
        "sface"
      ],
      "type": "string"
    },
    "OpenSetCurve": {
      "additionalProperties": false,
      "description": "TPIR against FPIR from accepting nothing to accepting every probe, about 200 points\nspaced evenly in log FPIR; each is a point of the full curve.",
      "properties": {
        "fpir": {
          "items": {
            "$ref": "#/$defs/Fraction"
          },
          "title": "Fpir",
          "type": "array"
        },
        "tpir": {
          "items": {
            "$ref": "#/$defs/Fraction"
          },
          "title": "Tpir",
          "type": "array"
        }
      },
      "required": [
        "fpir",
        "tpir"
      ],
      "title": "OpenSetCurve",
      "type": "object"
    },
    "OpenSetModel": {
      "additionalProperties": false,
      "description": "One recognition model's watchlist rehearsal: threshold frozen on validation, then the test\ndraw scored once at it.",
      "properties": {
        "model": {
          "$ref": "#/$defs/RecognitionModelId"
        },
        "crop": {
          "$ref": "#/$defs/Crop"
        },
        "rule": {
          "$ref": "#/$defs/MatchRule"
        },
        "threshold": {
          "$ref": "#/$defs/Cosine"
        },
        "target_fpir": {
          "$ref": "#/$defs/Fraction"
        },
        "validation": {
          "$ref": "#/$defs/DrawResult"
        },
        "test": {
          "$ref": "#/$defs/DrawResult"
        },
        "ms_per_face": {
          "exclusiveMinimum": 0.0,
          "title": "Ms Per Face",
          "type": "number"
        }
      },
      "required": [
        "model",
        "crop",
        "rule",
        "threshold",
        "target_fpir",
        "validation",
        "test",
        "ms_per_face"
      ],
      "title": "OpenSetModel",
      "type": "object"
    },
    "OpenSetPoint": {
      "additionalProperties": false,
      "description": "TPIR at the lowest threshold whose FPIR on this draw is at or below the target.\n\nThe threshold is the draw's own, so on the test draw this is a curve reading, not the frozen\noperating point; its interval re-chooses the threshold in every resample.",
      "properties": {
        "target_fpir": {
          "$ref": "#/$defs/Fraction"
        },
        "fpir": {
          "$ref": "#/$defs/Fraction"
        },
        "tpir": {
          "$ref": "#/$defs/Rate"
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cosine"
            },
            {
              "type": "null"
            }
          ]
        },
        "indicative": {
          "title": "Indicative",
          "type": "boolean"
        }
      },
      "required": [
        "target_fpir",
        "fpir",
        "tpir",
        "threshold",
        "indicative"
      ],
      "title": "OpenSetPoint",
      "type": "object"
    },
    "OperatingPoint": {
      "additionalProperties": false,
      "description": "TAR at the lowest threshold whose FAR is at or below the target.",
      "properties": {
        "target_far": {
          "$ref": "#/$defs/Fraction"
        },
        "far": {
          "$ref": "#/$defs/Fraction"
        },
        "tar": {
          "$ref": "#/$defs/Fraction"
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cosine"
            },
            {
              "type": "null"
            }
          ]
        },
        "indicative": {
          "title": "Indicative",
          "type": "boolean"
        }
      },
      "required": [
        "target_far",
        "far",
        "tar",
        "threshold",
        "indicative"
      ],
      "title": "OperatingPoint",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where and when a section was computed.",
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "machine": {
          "title": "Machine",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "dirty",
        "generated_at",
        "machine"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Provider": {
      "enum": [
        "cpu",
        "coreml"
      ],
      "type": "string"
    },
    "Published": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "$ref": "#/$defs/Fraction"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "accuracy",
        "source"
      ],
      "title": "Published",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "description": "A rate over probes with its 95% identity-level percentile bootstrap interval (#9).",
      "properties": {
        "value": {
          "$ref": "#/$defs/Fraction"
        },
        "ci": {
          "$ref": "#/$defs/Interval"
        },
        "adjusted_wilson": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value",
        "ci"
      ],
      "title": "Rate",
      "type": "object"
    },
    "RecognitionModelId": {
      "additionalProperties": false,
      "description": "A recognition model's identity: embeddings from two different ones never mix.",
      "properties": {
        "network": {
          "$ref": "#/$defs/Network"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "weights_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "dimension": {
          "exclusiveMinimum": 0,
          "title": "Dimension",
          "type": "integer"
        }
      },
      "required": [
        "network",
        "provider",
        "weights_sha256",
        "dimension"
      ],
      "title": "RecognitionModelId",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Split": {
      "enum": [
        "valid",
        "test"
      ],
      "type": "string"
    },
    "Verification": {
      "additionalProperties": false,
      "description": "LFW View 2, scored once per model, plus the View 1 choices that shaped the pipeline.",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "detector": {
          "$ref": "#/$defs/DetectorId"
        },
        "pairs": {
          "exclusiveMinimum": 0,
          "title": "Pairs",
          "type": "integer"
        },
        "excluded_images": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Images",
          "type": "array"
        },
        "view_1": {
          "items": {
            "$ref": "#/$defs/CropTrial"
          },
          "title": "View 1",
          "type": "array"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/LfwModel"
          },
          "title": "Models",
          "type": "array"
        },
        "sface_int8": {
          "$ref": "#/$defs/Int8Footnote"
        }
      },
      "required": [
        "provenance",
        "detector",
        "pairs",
        "excluded_images",
        "view_1",
        "models",
        "sface_int8"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "identification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identification"
        },
        {
