          "type": "integer"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/LearningModel"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "provenance",
        "bootstrap",
        "draws",
        "target_fpir",
        "folds",
        "models"
      ],
      "title": "Learning",
      "type": "object"
    },
    "LearningModel": {
      "additionalProperties": false,
      "description": "#10's comparison on one recognition model, and the rule it runs live as a result.",
      "properties": {
        "model": {
          "$ref": "#/$defs/RecognitionModelId"
