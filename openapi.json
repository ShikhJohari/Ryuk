{
  "openapi": "3.1.0",
  "info": {
    "title": "Ryuk",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "Get Models",
        "operationId": "getModels",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecognitionModelInfo"
                  },
                  "type": "array",
                  "title": "Response Getmodels"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/active-model": {
      "put": {
        "tags": [
          "models"
        ],
        "summary": "Set Active Model",
        "description": "Switch the active model: `409 cannot_be_active` for a model that is unavailable or not\nevaluated. The live monitor is told, and its next frame is judged by the new model.",
        "operationId": "setActiveModel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveModelChoice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecognitionModelInfo"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/persons": {
      "get": {
        "tags": [
          "persons"
        ],
        "summary": "List Persons",
        "operationId": "listPersons",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "on_watchlist",
                "removed",
                "all"
              ],
              "type": "string",
              "default": "on_watchlist",
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PersonOfInterestSummary"
                  },
                  "title": "Response Listpersons"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "persons"
        ],
        "summary": "Create Person",
        "operationId": "createPerson",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_createPerson"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonOfInterest"
                }
              }
            }
          },
          "409": {
            "description": "Warnings to acknowledge",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WarningsProblem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/persons/{person_id}": {
      "get": {
        "tags": [
          "persons"
        ],
        "summary": "Get Person",
        "operationId": "getPerson",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Person Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonOfInterest"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "persons"
        ],
        "summary": "Update Person",
        "description": "Rename, remove or restore a person of interest; an empty body changes nothing. Removal\ntakes them off the watchlist the live monitor matches against from its next frame.",
        "operationId": "updatePerson",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Person Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonOfInterestChanges"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonOfInterest"
                }
              }
            }
          },
          "409": {
            "description": "Warnings to acknowledge",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WarningsProblem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "persons"
        ],
        "summary": "Purge Person",
        "description": "Purge a person of interest, on the watchlist or removed: their enrolled photos,\nembeddings and sightings are erased, and they are cleared as runner-up on other sightings.\nNot reversible.",
        "operationId": "purgePerson",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Person Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/persons/{person_id}/photos": {
      "post": {
        "tags": [
          "persons"
        ],
        "summary": "Add Photo",
        "operationId": "addPhoto",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Person Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_addPhoto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrolledPhoto"
                }
              }
            }
          },
          "409": {
            "description": "Warnings to acknowledge",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WarningsProblem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/persons/{person_id}/photos/{photo_id}/image": {
      "get": {
        "tags": [
          "persons"
        ],
        "summary": "Get Photo Image",
        "operationId": "getPhotoImage",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Person Id"
            }
          },
          {
            "name": "photo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Photo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The enrolled photo, upright and without metadata",
            "content": {
              "image/jpeg": {},
              "image/png": {},
              "image/webp": {}
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/persons/{person_id}/photos/{photo_id}": {
      "delete": {
        "tags": [
          "persons"
        ],
        "summary": "Delete Photo",
        "operationId": "deletePhoto",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Person Id"
            }
          },
          {
            "name": "photo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Photo Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/sightings": {
      "get": {
        "tags": [
          "sightings"
        ],
        "summary": "List Sightings",
        "description": "Sightings newest first, of one person of interest if `personId` is given. `cursor` is\nthe previous page's `nextCursor`; any other value is `422 invalid_cursor`.",
        "operationId": "listSightings",
        "parameters": [
          {
            "name": "personId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Personid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SightingPage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/sightings/{sighting_id}": {
      "get": {
        "tags": [
          "sightings"
        ],
        "summary": "Get Sighting",
        "operationId": "getSighting",
        "parameters": [
          {
            "name": "sighting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sighting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sighting"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/sightings/{sighting_id}/crop": {
      "get": {
        "tags": [
          "sightings"
        ],
        "summary": "Get Sighting Crop",
        "operationId": "getSightingCrop",
        "parameters": [
          {
            "name": "sighting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sighting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The face of the sighting's best match, never the whole frame",
            "content": {
              "image/jpeg": {}
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActiveModelChoice": {
        "properties": {
          "modelKey": {
            "type": "string",
            "title": "Modelkey"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "modelKey"
        ],
        "title": "ActiveModelChoice",
        "description": "The model to make active. Any other field, such as a threshold, is refused with\n`422 invalid_request`: thresholds come from evaluation only."
      },
      "Body_addPhoto": {
        "properties": {
          "photo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Photo"
          },
          "acknowledgedWarnings": {
            "items": {
              "$ref": "#/components/schemas/WarningCode"
            },
            "type": "array",
            "title": "Acknowledgedwarnings"
          }
        },
        "type": "object",
        "required": [
          "photo"
        ],
        "title": "Body_addPhoto"
      },
      "Body_createPerson": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "photo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Photo"
          },
          "acknowledgedWarnings": {
            "items": {
              "$ref": "#/components/schemas/WarningCode"
            },
            "type": "array",
            "title": "Acknowledgedwarnings"
          }
        },
        "type": "object",
        "required": [
          "name",
          "photo"
        ],
        "title": "Body_createPerson"
      },
      "EnrolledPhoto": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "mediaType": {
            "type": "string",
            "title": "Mediatype"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "mediaType",
          "width",
          "height",
          "createdAt"
        ],
        "title": "EnrolledPhoto"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "ModelState": {
        "type": "string",
        "enum": [
          "active",
          "available",
          "not_evaluated",
          "unavailable"
        ]
      },
      "Network": {
        "type": "string",
        "enum": [
          "arcface",
          "facenet",
          "sface"
        ]
      },
      "PersonOfInterest": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/PersonStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "statusChangedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Statuschangedat"
          },
          "photos": {
            "items": {
              "$ref": "#/components/schemas/EnrolledPhoto"
            },
            "type": "array",
            "title": "Photos"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "statusChangedAt",
          "photos"
        ],
        "title": "PersonOfInterest"
      },
      "PersonOfInterestChanges": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/PersonStatus",
            "title": "Status"
          },
          "acknowledgedWarnings": {
            "items": {
              "$ref": "#/components/schemas/WarningCode"
            },
            "type": "array",
            "title": "Acknowledgedwarnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PersonOfInterestChanges",
        "description": "What PATCH changes: the name, the status, both or neither. A field left out is left as it\nis; null, or any other field such as `statusChangedAt`, is refused with\n`422 invalid_request` rather than ignored. A new name another person of interest already\nhas is refused with `409 warnings` until resent with `duplicate_name` acknowledged."
      },
      "PersonOfInterestSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/PersonStatus"
          },
          "photoCount": {
            "type": "integer",
            "title": "Photocount"
          },
          "coverPhotoId": {
            "type": "string",
            "title": "Coverphotoid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "statusChangedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Statuschangedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "photoCount",
          "coverPhotoId",
          "createdAt",
          "statusChangedAt"
        ],
        "title": "PersonOfInterestSummary"
      },
      "PersonStatus": {
        "enum": [
          "on_watchlist",
          "removed"
        ],
        "type": "string"
      },
      "Provider": {
        "type": "string",
        "enum": [
          "cpu",
          "coreml"
        ]
      },
      "RecognitionModelInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "weightsSha256": {
            "type": "string",
            "title": "Weightssha256"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "$ref": "#/components/schemas/ModelState"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
